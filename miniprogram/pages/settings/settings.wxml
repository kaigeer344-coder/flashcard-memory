<view class="container">
  <view class="subheader">
    <view class="back-btn" bindtap="onBack">‹</view>
    <view class="subheader-title">设置</view>
  </view>
  <view class="section-title">每组单词数</view>
  <view class="card word-count-card">
    <view class="word-count-selector">
      <view class="count-btn" data-delta="-1" bindtap="onWordCountChange">−</view>
      <view class="count-display">
        <text class="count-number">{{wordsPerRound}}</text>
        <text class="count-unit">个/组</text>
      </view>
      <view class="count-btn" data-delta="1" bindtap="onWordCountChange">+</view>
    </view>
    <view class="tip">每组学习完成后进入连连看复习，建议 5-15 个</view>
  </view>
  <view class="section-title">数据管理</view>
  <view class="card">
    <view class="menu-item danger" bindtap="onClearData">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除学习数据</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>

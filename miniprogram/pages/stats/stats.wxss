/* pages/stats/stats.wxss */
.header { text-align: center; padding: 20px 0 16px; }
.header-title { font-size: 22px; font-weight: 800; }

.overview-card { display: flex; padding: 24px 10px; }
.overview-item { flex: 1; text-align: center; }
.overview-value { font-size: 28px; font-weight: 800; color: #4CAF50; }
.overview-label { font-size: 12px; color: #888; margin-top: 4px; }

.asset-card { display: flex; padding: 20px 10px; }
.asset-item { flex: 1; text-align: center; }
.asset-icon { font-size: 22px; display: block; margin-bottom: 4px; }
.asset-value { font-size: 20px; font-weight: 800; color: #1A1A1A; }
.asset-label { font-size: 11px; color: #888; display: block; margin-top: 2px; }

.level-stat-row { padding: 14px 0; border-bottom: 1px solid #F0F0F0; }
.level-stat-row:last-child { border-bottom: none; }
.level-stat-header { display: flex; justify-content: space-between; margin-bottom: 6px; }
.level-stat-name { font-size: 14px; font-weight: 700; }
.level-stat-rate { font-size: 14px; font-weight: 700; color: #4CAF50; }
.level-stat-bar { height: 6px; background: #E0E0E0; border-radius: 3px; overflow: hidden; margin-bottom: 6px; }
.level-stat-fill { height: 100%; background: linear-gradient(90deg, #4CAF50, #66BB6A); border-radius: 3px; transition: width 0.3s; }
.level-stat-detail { font-size: 11px; color: #888; }

/* pages/learning/learning.wxss */

/* ===== 进度条 ===== */
.progress-section {
  margin-bottom: 20px;
}
.progress-text {
  text-align: center;
  font-size: 13px;
  color: #888;
  margin-bottom: 8px;
}
.progress-bar {
  height: 8px;
  background: #E0E0E0;
  border-radius: 4px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #66BB6A);
  border-radius: 4px;
  transition: width 0.3s ease;
}

/* ===== 闪卡 3D 翻转 ===== */
.flashcard-wrapper {
  perspective: 1200rpx;
  margin: 20px 0;
}
.flashcard {
  position: relative;
  width: 100%;
  height: 400rpx;
  transform-style: preserve-3d;
  transition: transform 0.6s ease;
}
.flashcard.flipped {
  transform: rotateY(180deg);
}
.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}
.card-front {
  background: linear-gradient(135deg, #ffffff 0%, #F5FBF0 100%);
}
.card-back {
  background: linear-gradient(135deg, #4CAF50 0%, #357A38 100%);
  color: #fff;
  transform: rotateY(180deg);
}
.word-en {
  font-size: 36px;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 8px;
}
.word-phonetic {
  font-size: 16px;
  color: #888;
  margin-bottom: 16px;
}
.card-tip {
  font-size: 12px;
  color: #aaa;
  margin-top: 16px;
}
.word-cn {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 8px;
}
.word-en-small {
  font-size: 14px;
  opacity: 0.8;
  margin-bottom: 16px;
}

/* ===== 发音按钮 ===== */
.speak-btn {
  text-align: center;
  font-size: 14px;
  color: #4CAF50;
  padding: 8px;
  margin-bottom: 20px;
}

/* ===== 评分按钮 ===== */
.rate-buttons {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}
.rate-btn {
  flex: 1;
  text-align: center;
  padding: 16px 8px;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.rate-btn:active {
  transform: scale(0.95);
}
.rate-icon {
  font-size: 28px;
  margin-bottom: 6px;
}
.rate-text {
  font-size: 13px;
  font-weight: 700;
}
.rate-unknown {
  border-top: 3px solid #E53935;
}
.rate-fuzzy {
  border-top: 3px solid #FFC107;
}
.rate-known {
  border-top: 3px solid #4CAF50;
}

/* ===== 完成页 ===== */
.finish-card {
  text-align: center;
  padding: 60px 20px;
}
.finish-icon {
  font-size: 64px;
  margin-bottom: 20px;
}
.finish-title {
  font-size: 22px;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 8px;
}
.finish-sub {
  font-size: 14px;
  color: #888;
  margin-bottom: 30px;
}

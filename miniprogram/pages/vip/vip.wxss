.subheader { display: flex; align-items: center; padding: 10px 0 16px; }
.back-btn { width: 36px; height: 36px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #4CAF50; }
.subheader-title { flex: 1; text-align: center; font-size: 18px; font-weight: 800; margin-right: 36px; }
.vip-hero { display: flex; align-items: center; gap: 14px; background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); border-radius: 18px; padding: 20px; margin-bottom: 16px; }
.vip-hero.activated { background: linear-gradient(135deg, #5D4037 0%, #3E2723 100%); }
.vip-hero-icon { font-size: 40px; }
.vip-hero-title { font-size: 18px; font-weight: 800; color: #fff; }
.vip-hero-sub { font-size: 12px; color: rgba(255,255,255,0.9); margin-top: 4px; }
.benefits-card { padding: 8px 16px; }
.benefit-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #F0F0F0; font-size: 14px; }
.benefit-row:last-child { border-bottom: none; }
.benefit-val { color: #4CAF50; font-weight: 700; }
.plans-grid { display: grid; grid-template-columns: 1fr 1.15fr 1fr; gap: 10px; margin-bottom: 16px; }
.plan-card { position: relative; background: #fff; border: 2px solid #E0E0E0; border-radius: 14px; padding: 16px 8px; text-align: center; }
.plan-card.featured { border-color: #FFD700; box-shadow: 0 4px 12px rgba(255,165,0,0.2); }
.plan-label { position: absolute; top: -8px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
.plan-name { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
.plan-price { font-size: 24px; font-weight: 800; color: #E53935; }
.plan-price .currency { font-size: 13px; }
.plan-unit { font-size: 11px; color: #888; margin-bottom: 8px; }
.plan-cta { background: #4CAF50; color: #fff; font-size: 12px; font-weight: 700; padding: 6px; border-radius: 8px; }
.vip-footer { text-align: center; font-size: 11px; color: #888; padding: 10px; }

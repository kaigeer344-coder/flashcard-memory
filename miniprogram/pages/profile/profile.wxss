/* pages/profile/profile.wxss */
.profile-card {
  display: flex;
  align-items: center;
  gap: 16px;
  background: linear-gradient(135deg, #4CAF50 0%, #357A38 100%);
  border-radius: 18px;
  padding: 20px;
  margin-bottom: 14px;
}
.profile-avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
}
.profile-info { flex: 1; }
.profile-name { font-size: 18px; font-weight: 800; color: #fff; }
.profile-meta { font-size: 13px; color: rgba(255,255,255,0.9); margin-top: 4px; }
.profile-meta .divider { margin: 0 6px; }

.vip-entry {
  display: flex;
  align-items: center;
  gap: 14px;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 16px;
  padding: 14px 18px;
  margin-bottom: 14px;
}
.vip-entry.activated {
  background: linear-gradient(135deg, #5D4037 0%, #3E2723 100%);
}
.vip-entry-icon { font-size: 28px; }
.vip-entry-text { flex: 1; }
.vip-entry-title { font-size: 16px; font-weight: 800; color: #fff; }
.vip-entry-sub { font-size: 12px; color: rgba(255,255,255,0.9); margin-top: 2px; }
.vip-entry-arrow { font-size: 22px; color: rgba(255,255,255,0.85); }

.asset-card { display: flex; padding: 20px 8px; }
.asset-item { flex: 1; text-align: center; }
.asset-icon { font-size: 22px; display: block; margin-bottom: 4px; }
.asset-value { font-size: 18px; font-weight: 800; color: #1A1A1A; }
.asset-label { font-size: 11px; color: #888; display: block; margin-top: 2px; }

.menu-card { padding: 0; overflow: hidden; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #F0F0F0;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 20px; margin-right: 12px; }
.menu-text { flex: 1; font-size: 15px; }
.menu-arrow { color: #ccc; font-size: 18px; }

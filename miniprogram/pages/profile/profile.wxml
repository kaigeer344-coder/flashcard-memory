<!-- pages/profile/profile.wxml -->
<view class="container">

  <!-- 个人信息卡片 -->
  <view class="profile-card">
    <view class="profile-avatar">👤</view>
    <view class="profile-info">
      <view class="profile-name">学习者</view>
      <view class="profile-meta">
        <text>积分 {{totalScore}}</text>
        <text class="divider">·</text>
        <text>连续 {{streak}} 天</text>
      </view>
    </view>
  </view>

  <!-- VIP 入口 -->
  <view class="vip-entry {{isVip ? 'activated' : ''}}" bindtap="onGoVip">
    <view class="vip-entry-icon">👑</view>
    <view class="vip-entry-text">
      <view class="vip-entry-title">{{isVip ? '会员尊享' : '开通会员'}}</view>
      <view class="vip-entry-sub">{{isVip ? vipPlanName + ' · 到期 ' + vipExpireDate : '解锁全部词库 · ¥9.9/月起'}}</view>
    </view>
    <view class="vip-entry-arrow">›</view>
  </view>

  <!-- 虚拟资产 -->
  <view class="section-title">我的资产</view>
  <view class="card asset-card">
    <view class="asset-item">
      <text class="asset-icon">🪙</text>
      <text class="asset-value">{{coins}}</text>
      <text class="asset-label">金币</text>
    </view>
    <view class="asset-item">
      <text class="asset-icon">💎</text>
      <text class="asset-value">{{gems}}</text>
      <text class="asset-label">宝石</text>
    </view>
    <view class="asset-item">
      <text class="asset-icon">💡</text>
      <text class="asset-value">{{hints}}</text>
      <text class="asset-label">提示</text>
    </view>
    <view class="asset-item">
      <text class="asset-icon">🔀</text>
      <text class="asset-value">{{shuffles}}</text>
      <text class="asset-label">洗牌</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="section-title">功能</view>
  <view class="card menu-card">
    <view class="menu-item" bindtap="onGoStats">
      <text class="menu-icon">📊</text>
      <text class="menu-text">学习统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoVip">
      <text class="menu-icon">👑</text>
      <text class="menu-text">会员中心</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

</view>
